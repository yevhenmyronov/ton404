# Локальний стан wrangler: кеш, тимчасові файли й копія Durable Object,
# яку створює `wrangler dev`. Нічого з цього не має їхати в історію.
.wrangler/

# Дозволи Claude Code — машинозалежні
.claude/settings.local.json

# Стан панелей Obsidian: змінюється від кожного відкриття файлу.
# Самі нотатки в історії лишаються — це частина проєкту.
obsidian/**/.obsidian/workspace*.json

# Картка для шеру. Тримається в репозиторії навмисно: вона частина сторінки,
# а не збірковий артефакт. Рядок нижче лишений як нагадування, що og.png
# мусить бути закомічений, інакше посилання в месенджерах виглядає мертвим.
!public/og.png

node_modules/
*.log
.DS_Store
Thumbs.db
